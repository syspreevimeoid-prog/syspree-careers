# Public — safe to expose in the browser bundle (read-only CDN access)
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production

# Secret — set this in the Vercel dashboard (Project Settings > Environment Variables),
# never commit it. Needs "Editor" permissions. Used only by web/api/apply.js.
SANITY_API_TOKEN=

# Optional — enables an email notification to HR on every new application.
# Leave unset to skip email; applications are still saved and visible in Sanity Studio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
HR_NOTIFY_EMAIL=hr@syspree.com
